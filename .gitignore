# PixelSearch — repository-root ignore (each subproject also has its own .gitignore)

# ---- Flutter / Dart ----
pixelsearch_app/build/
pixelsearch_app/.dart_tool/
pixelsearch_app/.flutter-plugins
pixelsearch_app/.flutter-plugins-dependencies
pixelsearch_app/android/local.properties
pixelsearch_app/android/.gradle/
pixelsearch_app/ios/Pods/
pixelsearch_app/.idea/
**/ephemeral/
*.iml

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ---- ModelKit large regenerable artifacts (regenerate: python prepare_model.py) ----
model_kit/out/*.onnx
# MobileCLIP exports are provisioned separately, not stored in Git.
# The smaller licensed SFace model below is an explicit offline-use exception.
*.onnx
pixelsearch_app/assets/models/*.onnx
# Approved offline People exception: SFace is bundled for network-free first use.
!pixelsearch_app/assets/models/face_recognition_sface_2021dec.onnx

# ---- Python ----
**/__pycache__/
*.pyc
.venv/
venv/

# ---- Secrets / local ----
.env
.env.*
!.env.example
*.jks
*.keystore
*.pem
*.key
.claude/
.codex/

# Local deliverables, diagnostics and regenerable output are not application source.
/output/
/tmp/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/coverage/
.coverage
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.apk
*.aab

# Private device search traces: filenames, labels and relevance judgments.
pixelsearch_app/local_evaluation/
pixelsearch_app/docs/RAW_SEMANTIC_DIAGNOSIS.md
